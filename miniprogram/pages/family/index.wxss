.hero { margin: 18rpx 0 28rpx; padding: 42rpx 34rpx; border-radius: 26rpx; color: #fff; background: linear-gradient(135deg, #438060, #74a978); }.hero text { display: block; font-size: 25rpx; opacity: .85; margin-bottom: 12rpx; }.hero view { font-size: 38rpx; font-weight: 700; }.panel, .code-card, .members { padding: 30rpx; background: #fff; border-radius: 24rpx; }.panel-title, .section-title { font-size: 31rpx; font-weight: 700; }.panel input { height: 90rpx; border-bottom: 1rpx solid #e8ece8; font-size: 29rpx; }.panel button { margin: 26rpx 0 0; background: #438060; color: #fff; }.panel .secondary { background: #e8f2eb; color: #327653; }.or { text-align: center; color: #9ba49e; margin: 24rpx; }.code-input { letter-spacing: 8rpx; font-weight: 700; }.code-card { display: flex; align-items: center; }.code-card > text { color: #7c877f; font-size: 26rpx; }.code { flex: 1; margin-left: 24rpx; letter-spacing: 7rpx; font-size: 34rpx; font-weight: 700; color: #3e7d5b; }.copy { margin: 0; color: #3e7d5b; background: #e8f2eb; font-size: 23rpx; }.tip { color: #88938b; font-size: 25rpx; line-height: 1.7; margin: 22rpx 10rpx 36rpx; }.section-title { margin: 0 4rpx 18rpx; }.section-title text { color: #919b94; font-size: 24rpx; font-weight: 400; margin-left: 8rpx; }.member { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #edf0ec; }.member:last-child { border: 0; }.member-avatar { width: 70rpx; height: 70rpx; border-radius: 50%; background: #e5f0e8; }.fallback { color: #3e7d5b; text-align: center; line-height: 70rpx; font-weight: 700; }.member-name { margin-left: 18rpx; font-size: 29rpx; }.member-name text { margin-left: 8rpx; color: #a1712e; font-size: 21rpx; }
