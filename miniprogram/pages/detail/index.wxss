.food-head { display: flex; align-items: center; margin: 20rpx 0 32rpx; }.emoji { width: 104rpx; height: 104rpx; border-radius: 26rpx; background: #e9f3ed; display: flex; justify-content: center; align-items: center; font-size: 54rpx; margin-right: 20rpx; }.name { font-size: 42rpx; font-weight: 700; }.location { font-size: 26rpx; color: #829087; margin-top: 8rpx; }.expiry { position: relative; padding: 30rpx; border-radius: 24rpx; background: #fff0de; color: #945b25; }.expiry-caption { font-size: 25rpx; }.edit-expiry { position: absolute; top: 22rpx; right: 24rpx; padding: 8rpx 18rpx; border-radius: 24rpx; background: #fff7eb; color: #aa6728; font-size: 23rpx; border: 1rpx solid #efcfaa; }.expiry-date { font-size: 44rpx; font-weight: 700; margin: 10rpx 0; }.relative { font-size: 27rpx; }.block { background: #fff; border-radius: 24rpx; padding: 28rpx; margin-top: 24rpx; }.block-title { font-size: 32rpx; font-weight: 700; }.block-note { color: #829087; font-size: 24rpx; margin: 10rpx 0 22rpx; }.option { display: inline-flex; width: 50%; height: 60rpx; align-items: center; font-size: 26rpx; }.reminder { margin-top: 18rpx; height: 82rpx; line-height: 82rpx; }.actions { display: flex; gap: 16rpx; margin-top: 48rpx; }.actions button { flex: 1; height: 90rpx; line-height: 90rpx; font-size: 28rpx; }.discard { background: #fff; color: #c85d55; border: 1rpx solid #edc5c1; }
.finished-note { margin-top: 28rpx; background: #e9f3ed; color: #47765a; border-radius: 18rpx; padding: 26rpx; font-size: 27rpx; line-height: 1.6; }
