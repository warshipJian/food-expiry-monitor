<view wx:if="{{food}}" class="page">
  <view class="food-head"><view class="emoji">🍱</view><view><view class="name">{{food.name}}</view><view class="location">存放于 {{food.storageLocation}}</view></view></view>
  <view class="expiry" bindtouchstart="startExpiryEdit" bindtouchend="cancelExpiryEdit" bindtouchcancel="cancelExpiryEdit"><text class="expiry-caption">到期日期</text><picker wx:if="{{editingExpiry}}" mode="date" value="{{food.expiryLabel}}" bindchange="correctExpiry" bindcancel="exitExpiryEdit"><view class="expiry-date editable">{{food.expiryLabel}} <text>›</text></view></picker><view wx:else class="expiry-date">{{food.expiryLabel}}</view><view class="relative">{{food.relative}}</view><view wx:if="{{food.status === 'active' && !editingExpiry}}" class="expiry-tip">长按 3 秒修改日期</view><view wx:if="{{editingExpiry}}" class="expiry-tip">点击日期选择新日期</view></view>
  <view wx:if="{{food.status === 'active'}}" class="block"><view class="block-title">到期提醒</view><view class="block-note">请先在小程序中授权微信订阅消息。</view><radio-group bindchange="chooseReminder"><label wx:for="{{[7,3]}}" wx:key="*this" class="option"><radio value="{{item}}" checked="{{item === reminderDays}}" color="#2f7d59"/>到期前 {{item}} 天</label></radio-group><button class="ghost-button reminder" loading="{{savingReminder}}" bindtap="saveReminder">设置提醒</button></view>
  <view wx:if="{{food.status === 'consumed'}}" class="finished-note">这件食物已经吃完，已保留在“我吃完了”清单中。</view>
  <view wx:if="{{food.status === 'active'}}" class="actions"><button class="primary-button" bindtap="consume">我吃完了</button><button class="discard" bindtap="discard">丢弃</button></view>
</view>
