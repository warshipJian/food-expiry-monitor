<view class="page">
  <view class="intro">把日期记下来，剩下的交给我。</view>
  <button class="scan" bindtap="scan">▣ 扫描商品条码</button>
  <view class="form-card">
    <view class="field"><text class="label">食品名称</text><input placeholder="例如：鲜牛奶" value="{{form.name}}" bindinput="inputName" /></view>
    <view class="field"><text class="label">到期日期</text><picker mode="date" value="{{form.expiryDate}}" bindchange="chooseDate"><view class="picker-value">{{form.expiryDate}} <text>›</text></view></picker></view>
    <view class="field"><text class="label">分类</text><picker range="{{categories}}" range-key="label" bindchange="chooseCategory"><view class="picker-value">{{categories[categoryIndex].label}} <text>›</text></view></picker></view>
    <view class="field"><text class="label">存放位置</text><picker range="{{locations}}" range-key="label" bindchange="chooseLocation"><view class="picker-value">{{locations[locationIndex].label}} <text>›</text></view></picker></view>
    <view class="field"><text class="label">数量</text><input type="digit" value="{{form.quantity}}" bindinput="inputQuantity" /><text class="unit">件</text></view>
  </view>
  <button class="primary-button save" loading="{{submitting}}" bindtap="submit">保存食物</button>
</view>
