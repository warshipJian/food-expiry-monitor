.intro { font-size: 30rpx; color: #718078; margin: 12rpx 0 28rpx; }.scan { border: 2rpx dashed #80ae93; background: #eff7f1; color: #2f7d59; height: 100rpx; line-height: 100rpx; margin-bottom: 24rpx; }.form-card { background: #fff; border-radius: 22rpx; padding: 0 24rpx; }.field { height: 108rpx; display: flex; align-items: center; border-bottom: 1rpx solid #edf0ec; }.field:last-child { border: 0; }.label { width: 160rpx; font-size: 28rpx; font-weight: 600; }.field input, .picker-value { flex: 1; font-size: 28rpx; color: #465148; text-align: right; }.picker-value text { color: #9aa59e; margin-left: 12rpx; }.unit { color: #829087; margin-left: 12rpx; }.save { margin-top: 40rpx; height: 92rpx; line-height: 92rpx; }
