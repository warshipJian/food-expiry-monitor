.hero { padding: 32rpx 8rpx 28rpx; }
.eyebrow { color: #6e8e7c; font-size: 26rpx; letter-spacing: 2rpx; }
.hero-title { font-size: 52rpx; line-height: 1.35; font-weight: 700; margin-top: 8rpx; }
.hero-subtitle { color: #718078; font-size: 28rpx; margin-top: 12rpx; }
.summary { display: flex; background: #fff; border-radius: 24rpx; padding: 26rpx 0; box-shadow: 0 8rpx 28rpx rgba(47, 80, 56, .06); }
.summary-cell { width: 33.3%; display: flex; flex-direction: column; align-items: center; font-size: 24rpx; color: #718078; border-right: 1rpx solid #edf0ec; }
.summary-cell:last-child { border: 0; }.number { font-size: 42rpx; color: #2f7d59; font-weight: 700; margin-bottom: 8rpx; }.warning .number { color: #e0903d; }.danger .number { color: #d95850; }
.add { margin: 28rpx 0 40rpx; height: 92rpx; line-height: 92rpx; font-size: 30rpx; }
.section-title { font-size: 32rpx; font-weight: 700; margin-bottom: 20rpx; }
.food-card { display: flex; align-items: center; background: #fff; padding: 24rpx; border-radius: 20rpx; margin-bottom: 16rpx; }
.food-icon { width: 76rpx; height: 76rpx; background: #f3f6ef; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; font-size: 38rpx; margin-right: 18rpx; }.food-info { flex: 1; min-width: 0; }.food-name { font-size: 30rpx; font-weight: 600; }.food-meta { color: #829087; font-size: 24rpx; margin-top: 8rpx; }.badge { padding: 9rpx 13rpx; border-radius: 10rpx; font-size: 22rpx; background: #e9f3ed; color: #2f7d59; }.badge.urgent { background: #fff0de; color: #c57525; }
.consumed-section { margin-top: 34rpx; }.consumed-toggle { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 4rpx; }.consumed-title { font-size: 30rpx; font-weight: 700; color: #526056; }.consumed-count { font-size: 24rpx; color: #94a098; margin-left: 12rpx; }.chevron { color: #94a098; font-size: 30rpx; }.consumed-card { opacity: .68; }.consumed-card .food-icon { color: #5b9978; font-size: 32rpx; }.consumed-badge { color: #708176; font-size: 24rpx; }
