.profile-card { background: #fff; border-radius: 24rpx; }.overview { padding: 42rpx 30rpx 34rpx; display: flex; flex-direction: column; align-items: center; }.avatar-wrap { width: 132rpx; height: 132rpx; border-radius: 50%; overflow: hidden; background: #e3f0e8; display: flex; align-items: center; justify-content: center; }.avatar { width: 132rpx; height: 132rpx; }.avatar-placeholder { color: #2f7d59; font-size: 44rpx; font-weight: 700; }.nickname { font-size: 34rpx; font-weight: 700; margin-top: 20rpx; }.profile-tip { font-size: 24rpx; color: #89958d; margin-top: 8rpx; }.edit-button { width: 100%; height: 80rpx; line-height: 80rpx; margin-top: 30rpx; background: #e9f3ed; color: #2f7d59; font-size: 28rpx; }
.family-card { margin-top: 20rpx; padding: 26rpx; border-radius: 24rpx; background: #fff; display: flex; align-items: center; }.family-icon { flex: 0 0 auto; width: 76rpx; height: 76rpx; line-height: 76rpx; text-align: center; background: #fff0d6; color: #ba7518; border-radius: 20rpx; font-weight: 700; }.family-info { flex: 1; margin-left: 20rpx; font-size: 30rpx; font-weight: 700; }.family-info text { display: block; margin-top: 8rpx; color: #8b968e; font-size: 24rpx; font-weight: 400; }.arrow { color: #a3aaa5; font-size: 44rpx; }
.history-title { margin: 46rpx 4rpx 20rpx; font-size: 32rpx; font-weight: 700; }.history-title text { color: #94a098; font-size: 25rpx; font-weight: 400; margin-left: 10rpx; }.history-empty { background: #fff; border-radius: 20rpx; color: #8b968e; padding: 36rpx; text-align: center; font-size: 27rpx; }.history-card { display: flex; align-items: center; padding: 24rpx; border-radius: 20rpx; background: #fff; margin-bottom: 16rpx; }.check { background: #e3f0e8; color: #438060; font-size: 30rpx; width: 68rpx; height: 68rpx; line-height: 68rpx; border-radius: 18rpx; text-align: center; margin-right: 18rpx; }.history-info { flex: 1; font-size: 29rpx; font-weight: 600; }.history-info text { display: block; color: #8b968e; font-size: 23rpx; font-weight: 400; margin-top: 7rpx; }.done { color: #708176; font-size: 24rpx; }
