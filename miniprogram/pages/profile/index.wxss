.intro { color: #718078; font-size: 28rpx; margin: 12rpx 4rpx 28rpx; }.profile-card { background: #fff; border-radius: 24rpx; padding: 0 26rpx; }.row { min-height: 138rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #edf0ec; }.row:last-child { border: 0; }.label { font-size: 30rpx; font-weight: 600; }.avatar-button { width: 94rpx; height: 94rpx; padding: 0; border-radius: 50%; overflow: hidden; background: #e3f0e8; display: flex; align-items: center; justify-content: center; }.avatar { width: 94rpx; height: 94rpx; }.avatar-placeholder { color: #2f7d59; font-size: 23rpx; }.nickname-row input { text-align: right; color: #465148; font-size: 29rpx; }.save { height: 92rpx; line-height: 92rpx; margin-top: 42rpx; }.privacy-note { color: #8b968e; font-size: 24rpx; line-height: 1.7; margin: 30rpx 12rpx; }
.history-title { margin: 46rpx 4rpx 20rpx; font-size: 32rpx; font-weight: 700; }.history-title text { color: #94a098; font-size: 25rpx; font-weight: 400; margin-left: 10rpx; }.history-empty { background: #fff; border-radius: 20rpx; color: #8b968e; padding: 36rpx; text-align: center; font-size: 27rpx; }.history-card { display: flex; align-items: center; padding: 24rpx; border-radius: 20rpx; background: #fff; margin-bottom: 16rpx; }.check { background: #e3f0e8; color: #438060; font-size: 30rpx; width: 68rpx; height: 68rpx; line-height: 68rpx; border-radius: 18rpx; text-align: center; margin-right: 18rpx; }.history-info { flex: 1; font-size: 29rpx; font-weight: 600; }.history-info text { display: block; color: #8b968e; font-size: 23rpx; font-weight: 400; margin-top: 7rpx; }.done { color: #708176; font-size: 24rpx; }
