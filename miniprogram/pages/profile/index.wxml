<view class="page">
  <view class="profile-card overview">
    <view class="avatar-wrap"><image wx:if="{{profile.avatarUrl}}" src="{{profile.avatarUrl}}" mode="aspectFill" class="avatar"/><text wx:else class="avatar-placeholder">我</text></view>
    <view class="nickname">{{profile.nickname || '微信用户'}}</view>
    <view class="profile-tip">管理属于你的食品清单</view>
    <button class="edit-button" bindtap="openEdit">编辑资料</button>
  </view>
  <view class="history-title">我吃完了 <text>{{consumedFoods.length}} 件</text></view>
  <view wx:if="{{!consumedFoods.length}}" class="history-empty">还没有吃完记录。</view>
  <view wx:for="{{consumedFoods}}" wx:key="id" class="history-card" bindtap="openFood" data-id="{{item.id}}"><view class="check">✓</view><view class="history-info"><view>{{item.name}}</view><text>到期日 {{item.expiryLabel}}</text></view><text class="done">已吃完</text></view>
</view>
