page {
  min-height: 100%;
  background: #faf8f2;
  color: #28342b;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

button { border-radius: 16rpx; }
button::after { border: none; }
.page { padding: 32rpx; }
.primary-button { background: #2f7d59; color: #fff; font-weight: 600; }
.ghost-button { background: #e9f3ed; color: #2f7d59; }
.empty { text-align: center; color: #829087; padding: 120rpx 32rpx; }
